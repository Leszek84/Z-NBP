# Local development without Docker.
# Copy to .env:  cp .env.example .env
# SQLite is used by default (no DATABASE_URL needed).

DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=False

# Uncomment to use PostgreSQL locally:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/z_nbp

# Uncomment to use Redis locally:
# REDIS_URL=redis://localhost:6379/1

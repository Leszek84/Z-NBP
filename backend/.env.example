DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret-key-32-plus-chars
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=False

# Local SQLite (default if no PostgreSQL vars are set):
# DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL via single URL (recommended for Docker/Azure):
# DATABASE_URL=postgres://postgres:postgres@db:5432/z_nbp

# PostgreSQL via separate variables (optional alternative):
# DB_NAME=z_nbp
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# Redis foundation (for caching utility data like exchange rates):
# REDIS_URL=redis://localhost:6379/1
# EXCHANGE_RATES_CACHE_TTL=300
# EXCHANGE_RATES_CACHE_KEY=exchange_rates_current
